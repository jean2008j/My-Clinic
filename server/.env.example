PORT=4000
DATABASE_FILE=./data/clinic.db
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
CLINIC_TZ=Europe/Amsterdam

# Seed accounts (used only by `npm run db:seed`)
SEED_ADMIN_EMAIL=admin@clinic.local
SEED_ADMIN_PASSWORD=Admin12345
SEED_PROVIDER_PASSWORD=Doctor12345

# Booking rules (optional, these are the defaults)
SLOT_STEP_MIN=15
MIN_NOTICE_MIN=60
MAX_ADVANCE_DAYS=60
CHANGE_CUTOFF_HOURS=2
MAX_UPCOMING_PER_PHONE=3
